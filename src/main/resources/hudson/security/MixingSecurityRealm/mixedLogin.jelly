<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:view contentType="text/html;charset=UTF-8">
    <st:setHeader name="Expires" value="0" />
    <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate" />
    <j:set var="_" value="${request2.getSession()}" />
    ${h.initPageVariables(context)}
    <x:doctype name="html" />
    <j:set var="from" value="${it.sanitizeFrom(request2.getParameter('from'), request2.contextPath)}" />
    <j:set var="simpleDecorator" value="${h.simplePageDecorator}" />
    <j:set var="simpleDecorators" value="${h.simplePageDecorators}" />

    <html lang="${request2.getLocale().toLanguageTag()}">
      <head data-rooturl="${rootURL}" data-resurl="${resURL}" data-imagesurl="${imagesURL}" resURL="${resURL}">
        <title>Sign In - Jenkins</title>
        <meta name="ROBOTS" content="NOFOLLOW" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <st:include it="${simpleDecorator}" page="simple-head.jelly" />
      </head>
      <body class="app-sign-in-register">
        <st:include it="${simpleDecorator}" page="simple-branding.jelly" />
        <main id="main-panel" class="app-sign-in-register__content">
          <div class="app-sign-in-register__content-inner">
            <h1>${%Sign in to Jenkins}</h1>

            <st:include it="${simpleDecorator}" page="simple-header.jelly" />

            <form name="login" action="${rootURL}/${app.securityRealm.authenticationGatewayUrl}" method="post">
              <div>
                <label class="app-sign-in-register__form-label" for="j_username">${%Username}</label>
                <input class="jenkins-input"
                       type="text"
                       name="j_username"
                       id="j_username"
                       autocorrect="off"
                       autocomplete="off"
                       autocapitalize="off"
                       autofocus="autofocus" />
              </div>
              <div>
                <label class="app-sign-in-register__form-label" for="j_password">${%Password}</label>
                <input id="j_password" class="jenkins-input" type="password" name="j_password" />
              </div>

              <j:if test="${app.security.name()=='SECURED' and !app.disableRememberMe}">
                <div class="jenkins-checkbox">
                  <input type="checkbox" id="remember_me" name="remember_me" />
                  <label for="remember_me">${%Keep me signed in}</label>
                </div>
              </j:if>

              <input type="hidden" name="from" value="${from}" />
              <input type="hidden" name="${h.getCrumbRequestField()}" value="${h.getCrumb(request2)}" />
              <button type="submit" name="Submit" class="jenkins-button jenkins-button--primary">Sign In</button>

              <j:if test="${app.securityRealm.allowsSignup()}">
                <div class="app-sign-in-register__switcher">
                  <a href="signup">${%or register}</a>
                </div>
              </j:if>
            </form>

            <j:set var="hasSsoOption" value="${false}" />
            <j:forEach var="optional" items="${it.optionals}" varStatus="loop">
              <j:if test="${it.getOptionalLoginUrl(loop.index) != null}">
                <j:set var="hasSsoOption" value="${true}" />
              </j:if>
            </j:forEach>

            <j:if test="${hasSsoOption}">
              <div style="margin-top: 1rem">
                <h2 style="margin: 0 0 0.5rem 0; font-size: 1rem">${%Sign in with external identity provider}</h2>
                <j:forEach var="optional" items="${it.optionals}" varStatus="loop">
                  <j:set var="ssoUrl" value="${it.getOptionalLoginUrl(loop.index)}" />
                  <j:if test="${ssoUrl != null}">
                    <div style="margin-bottom: 0.5rem">
                      <a class="jenkins-button"
                         href="${rootURL}/securityRealm/${ssoUrl}?from=${from}"
                         style="aspect-ratio: unset; padding: 0.5rem 1rem">
                        Sign in with ${optional.descriptor.displayName}
                      </a>
                    </div>
                  </j:if>
                </j:forEach>
              </div>
            </j:if>

            <div class="footer">
              <j:forEach var="decorator" items="${simpleDecorators}">
                <st:include it="${decorator}" page="simple-footer.jelly" optional="true" />
              </j:forEach>
            </div>
          </div>
        </main>
      </body>
    </html>
  </l:view>
</j:jelly>
